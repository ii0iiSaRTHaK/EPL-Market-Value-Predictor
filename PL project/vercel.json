{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --include=dev && npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,vendor/**,src/**,public/**,notebooks/**,reports/**,tests/**,.build/**}"
    }
  }
}

